# Website analytics (see ANALYTICS.md)
# Where the site sends its events. Leave empty to send nothing.
PUBLIC_ANALYTICS_ENDPOINT=
# Set to true to add "(ref xxxxxxxx)" to WhatsApp messages started from the site,
# so the bot can link a chat and its booking back to the website visit.
PUBLIC_ANALYTICS_WA_REF=false

# Admin sign-in with Supabase Auth (see ANALYTICS.md, "First-time setup"). Server-side only.
# Project URL and publishable (anon) key: Supabase dashboard > Project Settings > API.
# Never put the secret / service_role key here.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_publishable_key
# Comma-separated emails allowed into /admin. Each needs a Supabase Auth account with that email.
ADMIN_EMAILS=you@example.com

# IndexNow (scripts/ping-indexnow.mjs): tells Bing and other IndexNow search engines about
# new or changed pages right after a deploy. The same key must be served at /<key>.txt (public/).
INDEXNOW_KEY=your_32_char_hex_key
