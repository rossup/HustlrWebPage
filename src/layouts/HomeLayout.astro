---
import '../styles/home.css';
import { SITE_URL, PHONE_E164 } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search engines (used by the admin dashboard). */
  noindex?: boolean;
  /** Shrink the whole page slightly on larger screens (see "Whole-site scale" in home.css). The admin pages turn this off. */
  scale?: boolean;
  /** Extra schema.org data for this page: one object, an array, or { '@graph': [...] }.
      It's merged with the site-wide Organization and WebSite into one JSON-LD block. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Social share image (path or full URL, 1200x630) */
  ogImage?: string;
}

const {
  title = 'Hustlr | Plumbers, Electricians, Cleaners & Tutors in Zimbabwe',
  description = 'Find and book trusted plumbers, electricians, cleaners and tutors in Harare, Bulawayo and across Zimbabwe in one WhatsApp chat. Free to ask, no app needed.',
  noindex = false,
  scale = true,
  schema = [],
  ogImage = '/og-image.png',
} = Astro.props;

// Flatten whatever the page passed into a list of schema.org nodes
const pageNodes = (Array.isArray(schema) ? schema : [schema]).flatMap((node) =>
  Array.isArray(node['@graph']) ? (node['@graph'] as Record<string, unknown>[]) : [node],
);

// One address per page for search engines: always https://hustlr.chat, no trailing slash.
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '') || '/';
const canonical = `${SITE_URL}${path === '/' ? '/' : path}`;
const imageUrl = new URL(ogImage, SITE_URL).href;

// Who Hustlr is, for Google's knowledge panel and brand searches.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'Hustlr',
      alternateName: ['Hustlr Zimbabwe', 'Hustlr Chat'],
      url: `${SITE_URL}/`,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/apple-touch-icon.png`, width: 180, height: 180 },
      description: 'Hustlr finds and books plumbers, electricians, cleaners and tutors across Zimbabwe in one WhatsApp chat.',
      areaServed: { '@type': 'Country', name: 'Zimbabwe' },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: PHONE_E164,
        contactType: 'customer service',
        areaServed: 'ZW',
        availableLanguage: ['English', 'Shona', 'Ndebele'],
      },
      sameAs: ['https://wa.me/263719351207'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Hustlr',
      url: `${SITE_URL}/`,
      inLanguage: 'en-ZW',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    ...pageNodes,
  ],
};
---

<!doctype html>
<html lang="en-ZW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM context" />
    <meta name="theme-color" content="#0b1f16" />
    <meta name="geo.region" content="ZW" />
    <meta name="geo.placename" content="Zimbabwe" />
    {!noindex && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Hustlr" />
        <meta property="og:locale" content="en_ZW" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Hustlr: say what you need, Hustlr finds who does it, on WhatsApp" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={scale ? 'site-scale' : undefined}>
    <!-- Netlify Identity emails (admin invites, password resets) link to the homepage:
         hand those links to the login page, which finishes them. -->
    <script is:inline>
      if (/(invite|recovery|confirmation|email_change)_token=|access_token=/.test(location.hash) && !/^\/login\/?$/.test(location.pathname)) {
        location.replace('/login' + location.hash);
      }
    </script>
    <slot />
    <script>
      import '../scripts/analytics';
    </script>
  </body>
</html>
