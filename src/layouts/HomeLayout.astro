---
import '../styles/home.css';
import { SITE_URL, PHONE_E164, SAME_AS } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search engines (used by the admin dashboard). */
  noindex?: boolean;
  /** Shrink the whole page slightly on larger screens (see "Whole-site scale" in home.css). The admin pages turn this off. */
  scale?: boolean;
  /** Extra schema.org data for this page: one object, an array, or { '@graph': [...] }.
      It's merged with the site-wide Organization and WebSite into one JSON-LD block. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Social share image: path or full URL, 1200x630 JPG/PNG under 300KB (WhatsApp drops bigger ones) */
  ogImage?: string;
  /** Text description of the share image */
  ogImageAlt?: string;
  /** Point search engines at another page as the main version (e.g. "/plumbers/harare"). Defaults to this page. */
  canonicalPath?: string;
}

const {
  title = 'Hustlr | Plumbers, Electricians, Cleaners & Tutors in Zimbabwe',
  description = 'Find and book trusted plumbers, electricians, cleaners and tutors in Harare, Bulawayo and across Zimbabwe in one WhatsApp chat. Free to ask, no app needed.',
  noindex = false,
  scale = true,
  schema = [],
  ogImage = '/og-default.jpg',
  ogImageAlt = 'Hustlr — Hire Vetted Skilled Workers on WhatsApp in Zimbabwe',
  canonicalPath,
} = Astro.props;

// Flatten whatever the page passed into a list of schema.org nodes
const pageNodes = (Array.isArray(schema) ? schema : [schema]).flatMap((node) =>
  Array.isArray(node['@graph']) ? (node['@graph'] as Record<string, unknown>[]) : [node],
);

// One address per page for search engines: always https://hustlr.chat, no trailing slash.
const path = Astro.url.pathname.replace(/(^|\/)index(\.html)?$/, '').replace(/\/$/, '').replace(/\.html$/, '') || '/';
const canonicalTarget = canonicalPath ?? path;
const canonical = `${SITE_URL}${canonicalTarget === '/' ? '/' : canonicalTarget}`;
// Always an absolute https:// URL: WhatsApp's preview crawler ignores relative image paths
const imageUrl = new URL(ogImage, SITE_URL).href;

// Who Hustlr is, for Google's knowledge panel and brand searches.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'Hustlr',
      alternateName: ['Hustlr Zimbabwe', 'Hustlr Chat'],
      url: `${SITE_URL}/`,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/logo.png`, width: 512, height: 512 },
      description:
        "Zimbabwe's AI-powered WhatsApp marketplace connecting clients with vetted local skilled workers in English, ChiShona and IsiNdebele.",
      areaServed: { '@type': 'Country', name: 'Zimbabwe' },
      knowsLanguage: ['en', 'sn', 'nd'],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: PHONE_E164,
        contactType: 'customer service',
        areaServed: 'ZW',
        availableLanguage: ['English', 'Shona', 'Ndebele'],
        url: 'https://wa.me/263719351207',
      },
      // Public profiles that belong to this Hustlr (LinkedIn, Facebook, X, press...).
      // Add only live, verified URLs; they tell Google and AI models which "Hustlr" this is.
      sameAs: SAME_AS,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Hustlr',
      url: `${SITE_URL}/`,
      inLanguage: ['en-ZW', 'sn', 'nd'],
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    ...pageNodes,
  ],
};
---

<!doctype html>
<html lang="en-ZW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Display boards and TVs (e.g. HIK Vision Android panels) report a phone-sized width,
        so the site would show its mobile layout. On those screens, lay the page out at desktop
        width instead. Add ?view=desktop or ?view=mobile to any URL to force a layout on that
        device (remembered); ?view=auto goes back to automatic. */}
    <script is:inline>
      (function () {
        try {
          var key = 'hustlr-view', mode = null;
          var q = /[?&]view=(desktop|mobile|auto)\b/.exec(location.search);
          if (q) {
            mode = q[1];
            try { mode === 'auto' ? localStorage.removeItem(key) : localStorage.setItem(key, mode); } catch (e) {}
          } else {
            try { mode = localStorage.getItem(key); } catch (e) {}
          }
          var ua = navigator.userAgent || '';
          var tv = /\b(SmartTV|Smart-TV|GoogleTV|AndroidTV|Android TV|BRAVIA|AFT[A-Z]|CrKey|HbbTV|Tizen|Web0S|webOS|Large Screen|HIKVISION|Hikvision|HIK|DS-D\d|Rockchip|rk3\d{3}|Amlogic|HiSilicon)/i.test(ua);
          var sw = screen.width, sh = screen.height;
          var android = /Android/i.test(ua);
          var landscape = sw > sh;
          var shortSide = Math.min(sw, sh);
          // Display boards often run a phone-style browser that says "Mobile", so the browser
          // name alone isn't enough. A board is still recognisable:
          //  - an Android screen with no touch at all (every phone has touch), or
          //  - a landscape Android screen whose browser doesn't call itself a phone, or
          //  - a landscape Android screen too tall to be a phone on its side (phones are
          //    under ~460px tall when turned sideways; boards are 500px or more).
          var board = android && (
            navigator.maxTouchPoints === 0 ||
            (landscape && (!/Mobile/i.test(ua) || shortSide >= 500))
          );
          if (mode === 'desktop' || (mode !== 'mobile' && (tv || board))) {
            if (window.innerWidth < 1200) {
              var m = document.querySelector('meta[name="viewport"]');
              if (m) m.setAttribute('content', 'width=1440');
            }
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* Link-preview tags first: WhatsApp and other mobile crawlers read only the start of <head> */}
    {!noindex && (
      <>
        <meta property="og:site_name" content="Hustlr Zimbabwe" />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="en_ZW" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:secure_url" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
      </>
    )}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM context" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b1f16" />
    <meta name="geo.region" content="ZW" />
    <meta name="geo.placename" content="Zimbabwe" />
    <meta name="generator" content={Astro.generator} />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={scale ? 'site-scale' : undefined}>
    <!-- Supabase emails (admin invites, password resets) can land on the homepage:
         hand those links to the login page, which finishes them. -->
    <script is:inline>
      if (/(^#|&)(access_token|error_description)=/.test(location.hash) && !/^\/login\/?$/.test(location.pathname)) {
        location.replace('/login' + location.search + location.hash);
      }
    </script>
    <slot />
    <script>
      import '../scripts/analytics';
    </script>
  </body>
</html>
