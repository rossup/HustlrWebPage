---
// Site-wide footer: used on every page.
import { WA, WA_PROVIDER, services } from '../data/site';
import '../styles/redesign.css';

const areas = ['Harare & Chitungwiza', 'Bulawayo', 'Mutare', 'Gweru & Kwekwe', 'Masvingo & Vic Falls'];
const year = new Date().getFullYear();
---

<footer class="rd-footer" aria-label="Site footer">
  <div class="rd-wrap">
    <div class="rd-footer-top">
      <div class="rd-footer-brand">
        <a href="/" aria-label="Hustlr home"><img src="/assets/logo-reverse.svg" alt="Hustlr" width="100" height="36" /></a>
        <p>Trusted plumbers, electricians, cleaners and tutors across Zimbabwe, found and booked in one WhatsApp chat.</p>
      </div>

      <div class="rd-footer-cols">
        <div class="rd-footer-col">
          <h2>Services</h2>
          {services.map((s) => <a href="/#services">{s.name}</a>)}
        </div>
        <div class="rd-footer-col">
          <h2>Hustlr</h2>
          <a href="/#how-it-works">How it works</a>
          <a href="/#why">Built for WhatsApp</a>
          <a href="/#questions">Questions</a>
          <a href={WA_PROVIDER} target="_blank" rel="noopener">Join as a provider</a>
        </div>
        <div class="rd-footer-col">
          <h2>Areas</h2>
          {areas.map((a) => <span>{a}</span>)}
        </div>
        <div class="rd-footer-col">
          <h2>Contact</h2>
          <a href={WA} target="_blank" rel="noopener">+263 71 935 1207</a>
          <span class="rd-online">Online 24/7</span>
        </div>
      </div>
    </div>

    <div class="rd-footer-bottom">
      <span>© {year} Hustlr. Built by Zimnovate in Zimbabwe.</span>
      <nav aria-label="Legal">
        <a href="/privacy">Privacy policy</a>
        <a href="/terms">Terms &amp; conditions</a>
      </nav>
    </div>
  </div>
</footer>
