---
// Hero for the search and sign-up pages, in the homepage hero's style: deep ink fading into
// the page at the bottom, a mint pill, white headline with one word in mint, yellow button,
// and a WhatsApp window on a green glow. About half the screen tall.
import { waIcon } from '../../data/site';
import { PHONE } from '../../data/seo';
import WaChat from './WaChat.astro';

interface Crumb { name: string; href: string }
interface Message { from: 'out' | 'in'; text: string; lang?: string }
interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  h1: string;
  /** Part of the h1 shown in mint; must appear in h1 */
  mark?: string;
  lead: string;
  cta: { href: string; label: string; external?: boolean };
  /** Short facts, shown as one quiet line under the button */
  facts: string[];
  chat: { caption: string; messages: Message[] };
}

const { crumbs, eyebrow, h1, mark, lead, cta, facts, chat } = Astro.props;
const at = mark ? h1.lastIndexOf(mark) : -1;
const external = cta.external ?? true;
---

<header class="lp-head" id="top">
  <div class="rd-wrap lp-head-grid">
    <div class="lp-head-copy">
      <nav class="lp-crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
      <p class="lp-pill">{eyebrow}</p>
      <h1>
        {at >= 0 && mark ? (
          <Fragment>{h1.slice(0, at)}<em class="lp-mark">{mark}</em>{h1.slice(at + mark.length)}</Fragment>
        ) : (
          h1
        )}
      </h1>
      <p class="lp-lead">{lead}</p>
      <div class="lp-actions">
        <a href={cta.href} class="rd-btn rd-btn--yellow lp-cta" target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} data-placement="page"><Fragment set:html={waIcon} />{cta.label}</a>
        <span class="lp-save">or save <strong>{PHONE}</strong></span>
      </div>
      <p class="lp-facts">{facts.join(' · ')}</p>
    </div>

    <div class="lp-head-visual">
      <WaChat caption={chat.caption} messages={chat.messages} />
    </div>
  </div>
</header>
