---
// Card listing providers who asked to join and are waiting for review.
import { statusClass, type Application } from '../../data/admin';

interface Props {
  /** null = the bot backend isn't connected yet */
  applications: Application[] | null;
}

const { applications } = Astro.props;
---

<section class="ad-card" aria-labelledby="ad-apps-title">
  <div class="ad-card-head">
    <div>
      <h2 id="ad-apps-title">Waiting for review</h2>
      <p>Providers who asked to join on WhatsApp. Check their trade and areas, then approve them in the chat.</p>
    </div>
  </div>
  {!applications || applications.length === 0 ? (
    <p class="ad-empty">
      {applications === null ? 'Not connected yet: provider applications come from the bot backend.' : 'No providers waiting for review.'}
    </p>
  ) : (
  <ul class="ad-apps">
    {applications.map((a) => (
      <li>
        <span class="ad-apps-avatar" aria-hidden="true">{a.business.charAt(0)}</span>
        <span class="ad-apps-main">
          <strong>{a.business}</strong>
          <span>{a.trade} · {a.areas}</span>
        </span>
        <span class="ad-apps-date">Applied {a.applied}</span>
        <span class={statusClass(a.status)}>{a.status}</span>
      </li>
    ))}
  </ul>
  )}
</section>
