---
// Card listing providers who asked to join and are waiting for review.
import { statusClass, type Application, type ProviderStats } from '../../data/admin';

interface Props {
  /** null = the bot backend isn't connected yet */
  applications: Application[] | null;
  /** Every registered provider; null = not connected yet */
  providers?: ProviderStats | null;
}

const { applications, providers } = Astro.props;
---

<section class="ad-card" aria-labelledby="ad-apps-title">
  <div class="ad-card-head">
    <div>
      <h2 id="ad-apps-title">Waiting for review</h2>
      <p>Providers who asked to join on WhatsApp. Check their trade and areas, then approve them in the chat.</p>
    </div>
  </div>
  {!applications || applications.length === 0 ? (
    <p class="ad-empty">
      {applications === null ? 'Not connected yet: provider applications come from the bot backend.' : 'No providers waiting for review.'}
    </p>
  ) : (
  <ul class="ad-apps">
    {applications.map((a) => (
      <li>
        <span class="ad-apps-avatar" aria-hidden="true">{a.business.charAt(0)}</span>
        <span class="ad-apps-main">
          <strong>{a.business}</strong>
          <span>{a.trade} · {a.areas}</span>
        </span>
        <span class="ad-apps-date">Applied {a.applied}</span>
        <span class={statusClass(a.status)}>{a.status}</span>
      </li>
    ))}
  </ul>
  )}
</section>

{providers !== undefined && (
<section class="ad-card" aria-labelledby="ad-all-providers-title">
  <div class="ad-card-head">
    <div>
      <h2 id="ad-all-providers-title">All providers{providers ? ` (${providers.total})` : ''}</h2>
      <p>Everyone registered with Hustlr, newest first.{providers ? ` ${providers.verified} verified.` : ''}</p>
    </div>
  </div>
  {!providers || providers.list.length === 0 ? (
    <p class="ad-empty">
      {providers === null ? 'Not connected yet: the provider list comes from the bot backend.' : 'No providers registered yet.'}
    </p>
  ) : (
  <ul class="ad-apps">
    {providers.list.map((p) => (
      <li>
        <span class="ad-apps-avatar" aria-hidden="true">{p.business.charAt(0)}</span>
        <span class="ad-apps-main">
          <strong>{p.business}</strong>
          <span>{p.trade} · {p.areas}</span>
        </span>
        <span class="ad-apps-date">Joined {p.joined}</span>
        <span class={statusClass(p.status)}>{p.status}</span>
      </li>
    ))}
  </ul>
  )}
</section>
)}
