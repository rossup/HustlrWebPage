---
// Dark card: how many website visitors become chats, bookings and finished jobs.
import { fmt, pct, type FunnelStep, type Period } from '../../data/admin';

interface Props {
  funnel: FunnelStep[];
  period: Period;
}

const { funnel, period } = Astro.props;
const first = funnel[0]?.value ?? 0;
---

<article class="ad-card ad-card--dark">
  <div class="ad-card-head">
    <div>
      <h2>From visit to finished job</h2>
      <p>{period.label}</p>
    </div>
  </div>
  <ol class="ad-funnel">
    {funnel.map((f, i) => (
      <li>
        <div class="ad-funnel-top">
          <span>{f.step}</span>
          <strong>{f.value === null ? '—' : fmt(f.value)}</strong>
        </div>
        <div class="ad-funnel-track">{f.value !== null && <span style={`width:${Math.max(pct(f.value, first), 1.5)}%`}></span>}</div>
        {f.value === null ? (
          <p>Not connected yet</p>
        ) : (
          i > 0 && funnel[i - 1].value !== null && <p>{pct(f.value, funnel[i - 1].value ?? 0)}% of the step before</p>
        )}
      </li>
    ))}
  </ol>
</article>
