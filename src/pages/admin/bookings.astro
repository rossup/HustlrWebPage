---
// /admin/bookings — every booking in the period, with a status filter.
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatTiles from '../../components/admin/StatTiles.astro';
import BookingsTable from '../../components/admin/BookingsTable.astro';
import { bookingStatuses, fmt } from '../../data/admin';
import { loadAdminData } from '../../lib/admin-data';

export const prerender = false;

const data = await loadAdminData();
const { bookings } = data;

const notes: Record<string, string> = {
  Pending: 'Waiting for the provider',
  Confirmed: 'Provider said yes',
  Completed: 'Job finished',
  Cancelled: 'Did not go ahead',
};
// Tiles follow the booking's journey
const order = ['Pending', 'Confirmed', 'Completed', 'Cancelled'].filter((s) => (bookingStatuses as string[]).includes(s));
const tiles = order.map((s) => ({
  label: s,
  value: bookings === null ? '—' : fmt(bookings.filter((b) => b.status === s).length),
  note: bookings === null ? 'Bot backend not connected' : notes[s],
}));
---

<AdminLayout title="Bookings" lead="Recent bookings made through WhatsApp." active="bookings" data={data}>
  <StatTiles slot="head" tiles={tiles} period={data.period} />

  <BookingsTable title="Recent bookings" rows={bookings} filters />
</AdminLayout>
