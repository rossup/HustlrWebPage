---
// /admin/providers — providers who asked to join and are waiting for review.
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatTiles from '../../components/admin/StatTiles.astro';
import ProviderList from '../../components/admin/ProviderList.astro';
import { fmt } from '../../data/admin';
import { loadAdminData } from '../../lib/admin-data';

export const prerender = false;

const data = await loadAdminData();
const { applications } = data;

const count = (status: string) => (applications === null ? '—' : fmt(applications.filter((a) => a.status === status).length));
const trades = applications === null ? '—' : fmt(new Set(applications.map((a) => a.trade)).size);
const off = applications === null ? 'Bot backend not connected' : undefined;

const tiles = [
  { label: 'New', value: count('New'), note: off ?? 'Not looked at yet' },
  { label: 'Details requested', value: count('Details requested'), note: off ?? 'Waiting for the provider to reply' },
  { label: 'Trades', value: trades, note: off ?? 'Different trades applying' },
  { label: 'Waiting for review', value: applications === null ? '—' : fmt(applications.length), note: off ?? 'All open applications' },
];
---

<AdminLayout title="Providers" lead="Providers who asked to join Hustlr." active="providers" data={data}>
  <StatTiles slot="head" tiles={tiles} period={data.period} />

  <ProviderList applications={applications} />
</AdminLayout>
