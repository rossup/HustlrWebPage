---
import HomeLayout from '../layouts/HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ChatSteps from '../components/ChatSteps.astro';
import { WA, WA_PROVIDER, waIcon, steps, services, proBenefits } from '../data/site';

// WhatsApp conversation shown on the hero phones (copied from a real Hustlr chat).
type WaMsg = { from: 'in' | 'out'; html: string; time: string; quote?: string };
const chat: WaMsg[] = [
  { from: 'in', html: '1', time: '18:04' },
  {
    from: 'out',
    quote: '1',
    time: '18:04',
    html: `<b>Bright Cleaning Services</b><br>Verified<br><br><b>Category:</b> Cleaning Services<br><b>Areas:</b> Harare, Zimbabwe<br><br><i>Comprehensive cleaning services for buildings, offices, homes, schools, hospitals and more, including carpet and after-renovation cleaning.</i><br><span class="wa-rule"></span><b>What would you like to do?</b><br>• Describe your job to book this provider<br>• Reply <b>BACK</b> to see other providers`,
  },
  { from: 'in', html: 'Home cleaning services', time: '18:04' },
  {
    from: 'out',
    quote: 'Home cleaning services',
    time: '18:04',
    html: `<b>Please confirm your booking:</b><br><br><b>Provider:</b> Bright Cleaning Services<br><b>Service:</b> Cleaning<br><b>Location:</b> Harare<br><b>Job Details:</b> Home cleaning services<br><br><b>Reply:</b><br>• <b>CONFIRM</b> or <b>YES</b> to book<br>• <b>CANCEL</b> or <b>NO</b> to cancel<br>• Or type a different job description to update`,
  },
  { from: 'in', html: 'Yes', time: '18:05' },
  {
    from: 'out',
    quote: 'Yes',
    time: '18:05',
    html: `Your booking request has been sent to <b>Bright Cleaning Services</b>! They're now reviewing your request and will respond shortly.<br><br>I'll keep you updated on the status.<br>Would you like to save <b>Bright Cleaning Services</b> to your favorites for easy rebooking? Reply <b>SAVE</b> to add them.`,
  },
];
// Front phone shows the whole chat; back phone is the same chat a moment earlier.
const phones = [
  { kind: 'back', clock: '15:44', messages: chat.slice(0, 5), fab: true },
  { kind: 'front', clock: '15:45', messages: chat, fab: false },
];

// Stacked layers that give each phone its physical 3D titanium thickness.
const depth = Array.from({ length: 20 }, (_, i) => i);

const howSteps = [
  {
    n: '01',
    title: 'Say what you need',
    text: 'Type it the way you would tell a friend. “My geyser is leaking” works.',
    messages: [
      { from: 'me', html: 'I need a plumber' },
      { from: 'bot', html: 'Sure. Which area are you in, and when do you need someone?' },
    ],
  },
  {
    n: '02',
    title: 'Meet your match',
    text: 'Hustlr asks a question or two, then suggests providers who fit the job and your area.',
    messages: [
      { from: 'me', html: 'Avondale, today if possible' },
      { from: 'bot', html: 'I found plumbers who work around Avondale. Want me to book the first one for this afternoon?' },
    ],
  },
  {
    n: '03',
    title: 'Book it',
    text: 'Pick one and Hustlr sets it up. The provider messages you to confirm the details.',
    messages: [
      { from: 'me', html: 'Yes please' },
      { from: 'bot', html: "Done. They'll message you to confirm the time." },
    ],
  },
] satisfies { n: string; title: string; text: string; messages: { from: 'me' | 'bot'; html: string }[] }[];


const reasons = [
  {
    title: 'No app to install',
    caption: 'Hustlr is a WhatsApp contact',
    proof: `<div class="wm-head"><span class="wm-avatar">H</span><span>Hustlr<small>online</small></span></div><div class="wm-body"><div class="wm-contact"><span class="wm-avatar wm-avatar--lg">H</span><b>Hustlr</b><span>+263 71 935 1207</span></div></div>`,
    text: 'If WhatsApp is on your phone, Hustlr is too. Nothing to download, no account to create.',
    icon: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  },
  {
    title: 'Just type it',
    caption: 'Plain words are all it takes',
    proof: `<div class="wm-head"><span class="wm-avatar">H</span><span>Hustlr<small>online</small></span></div><div class="wm-body"><div class="wm wm--out">My geyser is leaking in Avondale</div><div class="wm wm--in wm-typing" aria-label="Hustlr is typing"><i></i><i></i><i></i></div></div>`,
    text: 'No menus or forms. Describe the job the way you would tell a friend.',
    icon: '<path d="M4 5.5h16v10H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/>',
  },
  {
    title: 'Light on data',
    caption: 'Text messages, not an app',
    proof: `<div class="wm-head"><span class="wm-avatar">H</span><span>Hustlr<small>online</small></span></div><div class="wm-body"><div class="wm wm--out">Home cleaning services</div><div class="wm wm--in">Got it. Which area are you in?</div><div class="wm wm--out">Harare</div></div>`,
    text: 'Everything happens in text messages, so a small data bundle goes a long way.',
    icon: '<path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M5.5 12.5a9.5 9.5 0 0 1 13 0"/><path d="M8.7 16a5 5 0 0 1 6.6 0"/><circle cx="12" cy="19.2" r="1"/>',
  },
  {
    title: 'See who you are booking',
    caption: 'A provider profile in the chat',
    proof: `<div class="wm-head"><span class="wm-avatar">H</span><span>Hustlr<small>online</small></span></div><div class="wm-body"><div class="wm wm--in"><b>Bright Cleaning Services</b><br>Verified<br><br><b>Category:</b> Cleaning Services<br><b>Areas:</b> Harare, Zimbabwe<br><br><i>Comprehensive cleaning services for buildings, offices, homes, schools, hospitals and more.</i></div></div>`,
    text: 'Each provider comes with their category, the areas they cover and what they do.',
    icon: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/>',
  },
  {
    title: 'Nothing happens until you say yes',
    caption: 'The confirmation step',
    proof: `<div class="wm-head"><span class="wm-avatar">H</span><span>Hustlr<small>online</small></span></div><div class="wm-body"><div class="wm wm--in"><b>Please confirm your booking:</b><br><br><b>Provider:</b> Bright Cleaning Services<br><b>Service:</b> Cleaning<br><b>Location:</b> Harare<br><br><b>Reply:</b><br>• <b>CONFIRM</b> or <b>YES</b> to book<br>• <b>CANCEL</b> or <b>NO</b> to cancel</div><div class="wm wm--out">Yes</div></div>`,
    text: 'Hustlr shows you the booking details first. Reply YES to book, or NO to cancel.',
    icon: '<circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.7 2.7L16.2 9.5"/>',
  },
  {
    title: 'Rebook in one reply',
    caption: 'Saving a favourite',
    proof: `<div class="wm-head"><span class="wm-avatar">H</span><span>Hustlr<small>online</small></span></div><div class="wm-body"><div class="wm wm--in">Would you like to save <b>Bright Cleaning Services</b> to your favorites for easy rebooking? Reply <b>SAVE</b> to add them.</div><div class="wm wm--out">SAVE</div></div>`,
    text: 'Liked the work? Reply SAVE to keep that provider in your favourites for next time.',
    icon: '<path d="M12 20s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10z"/>',
  },
];

const proSteps = [
  {
    n: '01',
    title: 'Say hello',
    text: 'Send “I want to register as a service provider” to Hustlr on WhatsApp.',
    messages: [
      { from: 'me', html: 'I want to register as a service provider' },
      { from: 'bot', html: "Great! Let's register you as a service provider on Hustlr.<br><br><b>(Step 1/7)</b> What is your full legal name?" },
    ],
  },
  {
    n: '02',
    title: 'Answer a few questions',
    text: 'Your name, business name, trade and the areas you cover, in 7 short steps.',
    messages: [
      { from: 'bot', html: '<b>(Step 2/7)</b> What is your business name?<br><i>(Reply <b>SKIP</b> if you operate under your personal name)</i>' },
      { from: 'me', html: 'Bright Cleaning Services' },
    ],
  },
  {
    n: '03',
    title: 'Start getting jobs',
    text: 'Booking requests from customers in your areas arrive in the same chat. Reply YES to take the job.',
    messages: [
      { from: 'bot', html: '<span class="ex-card-title">New booking request</span><span class="ex-row"><span>Service</span><span>Cleaning</span></span><span class="ex-row"><span>Where</span><span>Harare</span></span><span class="ex-row"><span>Job</span><span>Home cleaning services</span></span><span class="ex-note">Reply <b>YES</b> to accept this job.</span>' },
      { from: 'me', html: 'YES' },
    ],
  },
] satisfies { n: string; title: string; text: string; messages: { from: 'me' | 'bot'; html: string }[] }[];


const faqs = [
  {
    q: 'Do I need to install anything?',
    a: 'No. If you have WhatsApp, you already have everything you need. Hustlr works entirely inside the chat.',
  },
  {
    q: 'What does it cost?',
    a: 'Asking Hustlr to find someone is free. You agree the price for the job directly with the provider before any work starts.',
  },
  {
    q: 'What happens to my details?',
    a: 'We only share your job, area and contact with the provider you choose, so they can confirm the booking. Read our privacy policy for the details.',
  },
  {
    q: 'Which services can I find?',
    a: 'Plumbers, electricians, cleaners and tutors across Zimbabwe, with more trades on the way. If you are not sure, just ask in the chat.',
  },
];
---

<HomeLayout>
  <SiteNav />

  <!-- ============================== HERO (Hero v3) ============================== -->
  <section class="hero" id="top">
    <div class="wrap hero-wrap">


      <div class="hero-body">
        <div class="hero-copy">
          <span class="hero-eyebrow">Services across Zimbabwe</span>
          <h1>
            Say what you need.<br />
            <em>Hustlr</em> finds who<br />
            does it.
          </h1>
          <p class="hero-sub">Plumbers, electricians, cleaners and tutors, found and booked in a WhatsApp chat.</p>
          <div class="hero-actions">
            <a href={WA} class="btn btn--yellow" target="_blank" rel="noopener"><Fragment set:html={waIcon} />Chat on WhatsApp</a>
            <a href="#how-it-works" class="btn-circle" aria-label="See how it works">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
            </a>
          </div>
          <p class="hero-note">No app to install. No forms to fill.</p>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-3d-pedestal"></div>
          {phones.map((ph) => (
            <div class={`phone3d phone3d--${ph.kind}`}>
              <div class="phone3d-shadow"></div>
              <div class="phone3d-body">
                {depth.map((i) => <span class="phone3d-layer" style={`--i:${i}`}></span>)}
                <span class="phone3d-antenna phone3d-antenna--top"></span>
                <span class="phone3d-antenna phone3d-antenna--bottom"></span>
                <span class="phone3d-btn phone3d-btn--power"></span>
                <span class="phone3d-btn phone3d-btn--cam-control"></span>
                <span class="phone3d-ports">
                  <i></i><i></i><i></i><i></i>
                  <u class="phone3d-screw"></u>
                  <b class="phone3d-usb"></b>
                  <u class="phone3d-screw"></u>
                  <i></i><i></i><i></i><i></i>
                </span>
                <div class="phone">
                  <span class="phone-earpiece"></span>
                  <span class="phone-island">
                    <i class="phone-island-ir"></i>
                    <i class="phone-island-lens"></i>
                  </span>
                  <div class="phone-screen">
                    <div class="wa">
                      <div class="wa-status">
                        <span class="wa-clock">{ph.clock}</span>
                        <span class="wa-status-icons">
                          <i class="wa-dot-icon"></i><i class="wa-dot-icon"></i><i class="wa-dot-icon"></i><i class="wa-dot-small"></i>
                        </span>
                        <span class="wa-status-right">
                          <svg width="22" height="16" viewBox="0 0 24 18" fill="currentColor"><path d="M12 3C7.6 3 3.6 4.7.6 7.5L12 18 23.4 7.5C20.4 4.7 16.4 3 12 3z" opacity=".95"/></svg>
                          <svg width="20" height="16" viewBox="0 0 20 16" fill="currentColor"><rect x="1" y="11" width="3" height="5" rx="1"/><rect x="6" y="8" width="3" height="8" rx="1"/><rect x="11" y="4" width="3" height="12" rx="1" opacity=".55"/><rect x="16" y="0" width="3" height="16" rx="1" opacity=".55"/></svg>
                          <span class="wa-battery"><b>&#9889;</b>52</span>
                        </span>
                      </div>

                      <div class="wa-appbar">
                        <svg class="wa-back" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12H5M11 5l-7 7 7 7"/></svg>
                        <span class="wa-avatar"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4.2"/><path d="M4 20.5c0-3.6 3.6-6 8-6s8 2.4 8 6v.5H4z"/></svg></span>
                        <span class="wa-contact">Rufaro</span>
                        <svg class="wa-ico" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="2.5" y="6" width="13" height="12" rx="1.5"/><path d="M15.5 10.5 21.5 7v10l-6-3.5z"/></svg>
                        <svg class="wa-ico" width="31" height="31" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M21 16.4v3a2 2 0 0 1-2.2 2A19.6 19.6 0 0 1 2.6 5.2 2 2 0 0 1 4.6 3h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L8.2 10.8a16 16 0 0 0 5 5l1.3-1.3a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2z"/></svg>
                        <svg class="wa-ico wa-kebab" width="6" height="26" viewBox="0 0 6 26" fill="currentColor"><circle cx="3" cy="4" r="2.6"/><circle cx="3" cy="13" r="2.6"/><circle cx="3" cy="22" r="2.6"/></svg>
                      </div>

                      <div class="wa-chat">
                        <div class="wa-thread">
                          {ph.messages.map((m) => (
                            <div class={`wa-msg wa-msg--${m.from}`}>
                              {m.quote && (
                                <div class="wa-quote">
                                  <span class="wa-quote-name">Rufaro</span>
                                  <span class="wa-quote-text">{m.quote}</span>
                                </div>
                              )}
                              <div class="wa-text">
                                <Fragment set:html={m.html} />
                                <span class="wa-meta-spacer"></span>
                              </div>
                              <span class="wa-meta">
                                {m.time}
                                {m.from === 'out' && (
                                  <svg width="19" height="12" viewBox="0 0 19 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6.5 4.5 10 11.5 2M7.5 10 8 10.5 15.5 2"/></svg>
                                )}
                              </span>
                            </div>
                          ))}
                        </div>
                        {ph.fab && (
                          <span class="wa-fab"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l6 6 6-6M6 12l6 6 6-6"/></svg></span>
                        )}
                      </div>

                      <div class="wa-composer">
                        <div class="wa-input-pill">
                          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5H8A4.5 4.5 0 0 0 3.5 8v8A4.5 4.5 0 0 0 8 20.5h5.5l7-7V8a4.5 4.5 0 0 0-4-4.5z"/><path d="M13.5 20.5V16a2.5 2.5 0 0 1 2.5-2.5h4.5"/><circle cx="9" cy="10" r=".8" fill="currentColor"/><circle cx="15" cy="10" r=".8" fill="currentColor"/><path d="M8.5 14c1 1 2.2 1.5 3.5 1.5"/></svg>
                          <span class="wa-placeholder">Message</span>
                          <svg class="wa-clip" width="26" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M15.5 6.5v9a3.5 3.5 0 0 1-7 0V5a2.3 2.3 0 0 1 4.6 0v10a1.1 1.1 0 0 1-2.2 0V7"/></svg>
                          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2.8l1.5-2h6.4l1.5 2h2.8A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z"/><circle cx="12" cy="12.8" r="3.4"/></svg>
                        </div>
                        <span class="wa-mic"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14.5a3 3 0 0 0 3-3V5.5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3z"/><path d="M18 11.5a6 6 0 0 1-12 0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M12 17.5V21" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></span>
                      </div>

                      <div class="wa-navbar">
                        <span class="wa-home-bar"></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}

          <div class="chip-notified">
            <span class="chip-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            </span>
            Provider notified
          </div>

          <div class="badge-1chat">
            <strong>1 chat</strong>
            <span>from request to booking</span>
          </div>
        </div>
      </div>

      <div class="hero-strip">
        <a href="#how-it-works" class="strip-intro">
          <svg class="zigzag" viewBox="0 0 264 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 4 L11 14 L22 4 L33 14 L44 4 L55 14 L66 4 L77 14 L88 4 L99 14 L110 4 L121 14 L132 4 L143 14 L154 4 L165 14 L176 4 L187 14 L198 4 L209 14 L220 4 L231 14 L242 4 L253 14 L264 4" />
            <path d="M0 26 L11 36 L22 26 L33 36 L44 26 L55 36 L66 26 L77 36 L88 26 L99 36 L110 26 L121 36 L132 26 L143 36 L154 26 L165 36 L176 26 L187 36 L198 26 L209 36 L220 26 L231 36 L242 26 L253 36 L264 26" />
            <path class="zz-accent" d="M0 47 L11 57 L22 47 L33 57 L44 47 L55 57 L66 47 L77 57 L88 47 L99 57 L110 47 L121 57 L132 47 L143 57 L154 47 L165 57 L176 47 L187 57 L198 47 L209 57 L220 47 L231 57 L242 47 L253 57 L264 47" />
            <path d="M0 68 L11 78 L22 68 L33 78 L44 68 L55 78 L66 68 L77 78 L88 68 L99 78 L110 68 L121 78 L132 68 L143 78 L154 68 L165 78 L176 68 L187 78 L198 68 L209 78 L220 68 L231 78 L242 68 L253 78 L264 68" />
          </svg>
          <span class="strip-intro-title">How does it work?</span>
          <span class="strip-intro-link">Learn more &rarr;</span>
        </a>
        <ol class="strip-steps">
          {steps.map((s) => (
            <li>
              <span class="step-dot" aria-hidden="true"></span>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <main>
    <!-- ============================== CATEGORIES ============================== -->
    <div class="wrap-wide">
      <div class="categories">
        <span class="mono">What do you need?</span>
        <a href={`${WA}?text=${encodeURIComponent('I need a plumber')}`} target="_blank" rel="noopener">Plumbers</a>
        <a href={`${WA}?text=${encodeURIComponent('I need an electrician')}`} target="_blank" rel="noopener">Electricians</a>
        <a href={`${WA}?text=${encodeURIComponent('I need a cleaner')}`} target="_blank" rel="noopener">Cleaners</a>
        <a href={`${WA}?text=${encodeURIComponent('I need a tutor')}`} target="_blank" rel="noopener">Tutors</a>
      </div>
    </div>

    <!-- ============================== HOW IT WORKS ============================== -->
    <section class="section wrap-wide" id="how-it-works">
      <div class="section-head">
        <div>
          <span class="mono mono--green">How it works</span>
          <h2>How it works</h2>
        </div>
        <p>If you can send a WhatsApp message, you can use Hustlr. There are no menus to learn.</p>
      </div>

      <!-- The example chat and the steps share rows: each step sits beside the messages it describes -->
      <ChatSteps rows={howSteps}>
        <a href={WA} class="how-try" target="_blank" rel="noopener">Try it on WhatsApp <span aria-hidden="true">&rarr;</span></a>
      </ChatSteps>
    </section>

    <!-- ============================== SERVICES ============================== -->
    <section class="section wrap-wide" id="services">
      <div class="section-head">
        <div>
          <span class="mono mono--green">What you can book</span>
          <h2>Services</h2>
        </div>
        <p>Start with one of these, or just describe the job. Tap a card to open WhatsApp with the message ready to send.</p>
      </div>

      <div class="services-grid">
        {services.map((sv) => (
          <a
            id={sv.id}
            class="service-card"
            href={`${WA}?text=${encodeURIComponent(sv.ask)}`}
            target="_blank"
            rel="noopener"
          >
            <span class="service-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={sv.icon} />
            </span>
            <h3>{sv.name}</h3>
            <p>{sv.text}</p>
            <span class="service-ask">
              <span class="mono">Try saying</span>
              <span class="service-bubble">“{sv.ask}”</span>
            </span>
            <span class="service-link">Ask on WhatsApp <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
    </section>

    <!-- ============================== ONE CHAT, TWO SIDES ============================== -->
    <section class="section wrap-wide" id="providers">
      <div class="section-head">
        <div>
          <span class="mono mono--green">Made for both sides</span>
          <h2>One chat, two sides</h2>
        </div>
        <p>Whether you need the work or do the work, you start the same way: by saying hello.</p>
      </div>

      <div class="sides">
        <article class="side side--light">
          <span class="mono mono--green">For customers</span>
          <h3>Ask.</h3>
          <p class="side-lead">Find someone for the job without calling around.</p>
          <ol>
            <li><span class="side-dot" aria-hidden="true"></span>Describe the job in your own words</li>
            <li><span class="side-dot" aria-hidden="true"></span>Get providers that suit your area</li>
            <li><span class="side-dot" aria-hidden="true"></span>Book from the same conversation</li>
          </ol>
          <a href={WA} class="btn btn--dark" target="_blank" rel="noopener"><Fragment set:html={waIcon} />Start a chat</a>
        </article>

        <article class="side side--dark">
          <span class="mono mono--yellow">For providers</span>
          <h3>Be found.</h3>
          <p class="side-lead">Get in front of people who are ready to hire.</p>
          <ol>
            <li><span class="side-dot" aria-hidden="true"></span>Set up your profile by chatting</li>
            <li><span class="side-dot" aria-hidden="true"></span>Tell Hustlr your trade and the areas you cover</li>
            <li><span class="side-dot" aria-hidden="true"></span>Receive booking requests on WhatsApp</li>
          </ol>
          <a href={WA_PROVIDER} class="btn btn--yellow" target="_blank" rel="noopener"><Fragment set:html={waIcon} />Join as a provider</a>
        </article>
      </div>
    </section>

    <!-- ============================== FOR PROVIDERS ============================== -->
    <section class="section wrap-wide" id="for-providers">
      <div class="section-head">
        <div>
          <span class="mono mono--green">For providers</span>
          <h2>Grow your business on WhatsApp</h2>
        </div>
        <p>Hustlr brings booking requests from people nearby straight to your WhatsApp. You decide which jobs to take.</p>
      </div>

      <ChatSteps rows={proSteps} status="online · provider sign-up">
        <a href={WA_PROVIDER} class="btn btn--dark" target="_blank" rel="noopener"><Fragment set:html={waIcon} />Join as a provider</a>
      </ChatSteps>

      <ul class="pro-benefits">
        {proBenefits.map((b) => (
          <li>
            <span class="pro-benefit-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={b.icon} />
            </span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- ============================== BUILT FOR WHATSAPP ============================== -->
    <section class="section wrap-wide" id="why">
      <div class="why">
        <div class="section-head section-head--dark">
          <div>
            <span class="mono mono--yellow">Why it works</span>
            <h2>Built for WhatsApp</h2>
          </div>
          <p>The way people already find help: ask someone. Hustlr just makes sure the right person answers.</p>
        </div>
        <!-- Pick a reason on the left; the right shows the chat that proves it.
             On phones each proof opens under its reason. -->
        <ol class="why-list" data-why>
          {reasons.map((r, i) => (
            <li class={`why-item${i === 0 ? ' is-active' : ''}`}>
              <button class="why-trigger" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`why-proof-${i}`}>
                <span class="why-index" aria-hidden="true"></span>
                <span class="why-title">{r.title}</span>
                <span class="why-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon} />
                </span>
              </button>
              <p class="why-text">{r.text}</p>
              <figure class="why-proof" id={`why-proof-${i}`}>
                <div class="wm-phone" set:html={r.proof} />
                <figcaption class="mono">{r.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============================== QUESTIONS ============================== -->
    <section class="section wrap-wide faq" id="questions">
      <div class="faq-intro">
        <span class="mono mono--green">Good to know</span>
        <h2>Questions</h2>
        <p>The short answers. For anything else, ask in the chat.</p>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <span class="faq-plus" aria-hidden="true"></span>
            </summary>
            <p>
              {f.a}
              {f.q === 'What happens to my details?' && <> <a href="/privacy">Privacy policy</a></>}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- ============================== SAY HELLO ============================== -->
    <section class="wrap-wide">
      <div class="hello">
        <div>
          <span class="mono mono--yellow">Your next job starts here</span>
          <h2>Say hello.</h2>
        </div>
        <div class="hello-side">
          <p>Tell Hustlr what you need, or what you do. It takes one message.</p>
          <a href={WA} class="btn btn--yellow" target="_blank" rel="noopener"><Fragment set:html={waIcon} />Chat on WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    // ---- How it works: reveal each row (message, reply, step) as it scrolls in ----
    const howRows = document.querySelectorAll<HTMLElement>('.how-row');
    if (howRows.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('how-animate');
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            // rows use display: contents, so we watch each row's chat block
            e.target.parentElement?.classList.add('is-in');
            io.unobserve(e.target);
          }
        }),
        { rootMargin: '0px 0px -18% 0px' }
      );
      howRows.forEach((r) => {
        const chat = r.querySelector('.how-row-chat');
        if (chat) io.observe(chat);
      });
    }

    // ---- Why it works: pick a reason, show its proof; rotates until someone picks ----
    const whyList = document.querySelector<HTMLElement>('[data-why]');
    if (whyList) {
      const items = [...whyList.querySelectorAll<HTMLElement>('.why-item')];
      let active = 0;
      let timer = 0;
      const show = (i: number) => {
        active = i;
        items.forEach((it, j) => {
          it.classList.toggle('is-active', j === i);
          it.querySelector('.why-trigger')?.setAttribute('aria-expanded', String(j === i));
        });
      };
      const stop = () => window.clearInterval(timer);
      items.forEach((it, i) => {
        const btn = it.querySelector<HTMLButtonElement>('.why-trigger');
        btn?.addEventListener('click', () => { stop(); show(i); });
        btn?.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
          e.preventDefault();
          const next = (i + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
          items[next].querySelector<HTMLButtonElement>('.why-trigger')?.focus();
        });
      });
      const wide = window.matchMedia('(min-width: 1025px)');
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (wide.matches && !calm.matches && 'IntersectionObserver' in window) {
        new IntersectionObserver((entries) => entries.forEach((e) => {
          stop();
          if (e.isIntersecting) timer = window.setInterval(() => show((active + 1) % items.length), 6000);
        }), { threshold: 0.4 }).observe(whyList);
        whyList.addEventListener('pointerenter', stop);
      }
    }

    // ---- Tilt the 3D phones toward the pointer ----
    const hero = document.querySelector<HTMLElement>('.hero');
    const visual = document.querySelector<HTMLElement>('.hero-visual');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (hero && visual && !reduce) {
      let frame = 0;
      hero.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const r = hero.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          visual.style.setProperty('--tilt-y', `${(x * 16).toFixed(2)}deg`);
          visual.style.setProperty('--tilt-x', `${(-y * 10).toFixed(2)}deg`);
        });
      });
      hero.addEventListener('pointerleave', () => {
        visual.style.setProperty('--tilt-y', '0deg');
        visual.style.setProperty('--tilt-x', '0deg');
      });
    }
  </script>
</HomeLayout>
