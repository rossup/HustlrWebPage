---
import HomeLayout from '../layouts/HomeLayout.astro';

const WA = 'https://wa.me/263712345678';
const WA_PROVIDER = `${WA}?text=${encodeURIComponent('Hi Hustlr, I want to register as a service provider')}`;

const steps = [
  { n: '1', title: 'Say what you need', text: 'Type it the way you would tell a friend.' },
  { n: '2', title: 'Meet your match', text: 'Hustlr suggests providers for your job and area.' },
  { n: '3', title: 'Book it', text: 'Pick one. The provider messages to confirm.' },
];

const howSteps = [
  { n: '01', title: 'Say what you need', text: 'Type it the way you would tell a friend. “My geyser is leaking” works.' },
  { n: '02', title: 'Meet your match', text: 'Hustlr asks a question or two, then suggests providers who fit the job and your area.' },
  { n: '03', title: 'Book it', text: 'Pick one and Hustlr sets it up. The provider messages you to confirm the details.' },
];

const faqs = [
  {
    q: 'Do I need to install anything?',
    a: 'No. If you have WhatsApp, you already have everything you need. Hustlr works entirely inside the chat.',
  },
  {
    q: 'What does it cost?',
    a: 'Asking Hustlr to find someone is free. You agree the price for the job directly with the provider before any work starts.',
  },
  {
    q: 'What happens to my details?',
    a: 'We only share your job, area and contact with the provider you choose, so they can confirm the booking. Read our privacy policy for the details.',
  },
  {
    q: 'Which services can I find?',
    a: 'Plumbers, electricians, cleaners and tutors across Zimbabwe, with more trades on the way. If you are not sure, just ask in the chat.',
  },
];
---

<HomeLayout>
  <!-- ============================== HERO (Hero v3) ============================== -->
  <section class="hero" id="top">
    <div class="wrap hero-wrap">
      <header class="nav">
        <a href="#top" class="logo logo--light" aria-label="Hustlr home">Hustlr<span>.</span></a>
        <nav class="nav-links" aria-label="Primary">
          <a href="#top">Home</a>
          <a href="#how-it-works">How it works</a>
          <a href="#providers">Providers</a>
          <a href="#questions">Questions</a>
        </nav>
        <a href={WA} class="nav-cta" target="_blank" rel="noopener">
          <span>Chat on WhatsApp</span>
          <span class="nav-cta-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </header>

      <div class="hero-body">
        <div class="hero-copy">
          <span class="hero-eyebrow">Services across Zimbabwe</span>
          <h1>
            Say what you need.<br />
            <em>Hustlr</em> finds who<br />
            does it.
          </h1>
          <p class="hero-sub">Plumbers, electricians, cleaners and tutors, found and booked in a WhatsApp chat.</p>
          <div class="hero-actions">
            <a href={WA} class="btn btn--yellow btn--lg" target="_blank" rel="noopener">Chat on WhatsApp</a>
            <a href="#how-it-works" class="btn-circle" aria-label="See how it works">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
            </a>
          </div>
          <p class="hero-note">No app to install. No forms to fill.</p>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <!-- Back phone: provider view -->
          <div class="phone phone--back">
            <div class="phone-screen">
              <div class="phone-island"></div>
              <div class="wa-head">
                <span class="wa-avatar">H</span>
                <span class="wa-name">Hustlr<small>online</small></span>
              </div>
              <div class="wa-body">
                <div class="bubble bubble--in">You have a new job near you.</div>
                <div class="wa-card">
                  <div class="wa-card-title">New booking request</div>
                  <div class="wa-row"><span>Service</span><span>Plumber</span></div>
                  <div class="wa-row"><span>When</span><span>Today, 3:00 pm</span></div>
                  <div class="wa-row"><span>Where</span><span>Avondale</span></div>
                  <p class="wa-card-note">Reply YES to accept this job.</p>
                </div>
              </div>
              <div class="wa-input">Message</div>
            </div>
          </div>

          <!-- Front phone: customer view -->
          <div class="phone phone--front">
            <div class="phone-screen">
              <div class="phone-island"></div>
              <div class="wa-head">
                <span class="wa-avatar">H</span>
                <span class="wa-name">Hustlr<small>online</small></span>
              </div>
              <div class="wa-body">
                <div class="bubble bubble--out">I need a plumber in Avondale today</div>
                <div class="bubble bubble--in">Found plumbers who work around Avondale. Want me to book the first one for 3:00 pm?</div>
                <div class="bubble bubble--out">Yes please</div>
                <div class="wa-card">
                  <div class="wa-card-title">Booking request sent</div>
                  <div class="wa-row"><span>Service</span><span>Plumber</span></div>
                  <div class="wa-row"><span>When</span><span>Today, 3:00 pm</span></div>
                  <div class="wa-row"><span>Where</span><span>Avondale</span></div>
                  <p class="wa-card-note">They'll message you to confirm the time.</p>
                </div>
              </div>
              <div class="wa-input">Message</div>
            </div>
          </div>

          <div class="chip-notified">
            <span class="chip-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            </span>
            Provider notified
          </div>

          <div class="badge-1chat">
            <strong>1 chat</strong>
            <span>from request to booking</span>
          </div>
        </div>
      </div>

      <div class="hero-strip">
        <a href="#how-it-works" class="strip-intro">
          <svg class="zigzag" viewBox="0 0 264 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 4 L11 14 L22 4 L33 14 L44 4 L55 14 L66 4 L77 14 L88 4 L99 14 L110 4 L121 14 L132 4 L143 14 L154 4 L165 14 L176 4 L187 14 L198 4 L209 14 L220 4 L231 14 L242 4 L253 14 L264 4" />
            <path d="M0 26 L11 36 L22 26 L33 36 L44 26 L55 36 L66 26 L77 36 L88 26 L99 36 L110 26 L121 36 L132 26 L143 36 L154 26 L165 36 L176 26 L187 36 L198 26 L209 36 L220 26 L231 36 L242 26 L253 36 L264 26" />
            <path class="zz-accent" d="M0 47 L11 57 L22 47 L33 57 L44 47 L55 57 L66 47 L77 57 L88 47 L99 57 L110 47 L121 57 L132 47 L143 57 L154 47 L165 57 L176 47 L187 57 L198 47 L209 57 L220 47 L231 57 L242 47 L253 57 L264 47" />
            <path d="M0 68 L11 78 L22 68 L33 78 L44 68 L55 78 L66 68 L77 78 L88 68 L99 78 L110 68 L121 78 L132 68 L143 78 L154 68 L165 78 L176 68 L187 78 L198 68 L209 78 L220 68 L231 78 L242 68 L253 78 L264 68" />
          </svg>
          <span class="strip-intro-title">How does it work?</span>
          <span class="strip-intro-link">Learn more &rarr;</span>
        </a>
        <ol class="strip-steps">
          {steps.map((s) => (
            <li>
              <span class="step-dot">{s.n}</span>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <main>
    <!-- ============================== CATEGORIES ============================== -->
    <div class="wrap-wide">
      <div class="categories">
        <span class="mono">What do you need?</span>
        <a href={`${WA}?text=${encodeURIComponent('I need a plumber')}`} target="_blank" rel="noopener">Plumbers</a>
        <a href={`${WA}?text=${encodeURIComponent('I need an electrician')}`} target="_blank" rel="noopener">Electricians</a>
        <a href={`${WA}?text=${encodeURIComponent('I need a cleaner')}`} target="_blank" rel="noopener">Cleaners</a>
        <a href={`${WA}?text=${encodeURIComponent('I need a tutor')}`} target="_blank" rel="noopener">Tutors</a>
      </div>
    </div>

    <!-- ============================== HOW IT WORKS ============================== -->
    <section class="section wrap-wide" id="how-it-works">
      <div class="section-head">
        <div>
          <span class="mono mono--green">01 / How it works</span>
          <h2>How it works</h2>
        </div>
        <p>If you can send a WhatsApp message, you can use Hustlr. There are no menus to learn.</p>
      </div>

      <div class="how-grid">
        <div class="how-card">
          <div class="example-chat">
            <span class="mono example-label">Example chat</span>
            <div class="ex ex--out">I need a plumber</div>
            <div class="ex ex--in">Sure. Which area are you in, and when do you need someone?</div>
            <div class="ex ex--out">Avondale, today if possible</div>
            <div class="ex ex--in">I found plumbers who work around Avondale. Want me to book the first one for this afternoon?</div>
            <div class="ex ex--out">Yes please</div>
            <div class="ex ex--in">Done. They'll message you to confirm the time.</div>
          </div>
        </div>

        <ol class="how-steps">
          {howSteps.map((s) => (
            <li>
              <span class="mono mono--green">{s.n}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============================== ONE CHAT, TWO SIDES ============================== -->
    <section class="section wrap-wide" id="providers">
      <div class="section-head">
        <div>
          <span class="mono mono--green">02 / Made for both sides</span>
          <h2>One chat, two sides</h2>
        </div>
        <p>Whether you need the work or do the work, you start the same way: by saying hello.</p>
      </div>

      <div class="sides">
        <article class="side side--light">
          <span class="mono mono--green">For customers</span>
          <h3>Ask.</h3>
          <p class="side-lead">Find someone for the job without calling around.</p>
          <ol>
            <li><span class="mono">01</span>Describe the job in your own words</li>
            <li><span class="mono">02</span>Get providers that suit your area</li>
            <li><span class="mono">03</span>Book from the same conversation</li>
          </ol>
          <a href={WA} class="btn btn--dark" target="_blank" rel="noopener">Start a chat</a>
        </article>

        <article class="side side--dark">
          <span class="mono mono--yellow">For providers</span>
          <h3>Be found.</h3>
          <p class="side-lead">Get in front of people who are ready to hire.</p>
          <ol>
            <li><span class="mono">01</span>Set up your profile by chatting</li>
            <li><span class="mono">02</span>Tell Hustlr your trade and the areas you cover</li>
            <li><span class="mono">03</span>Receive booking requests on WhatsApp</li>
          </ol>
          <a href={WA_PROVIDER} class="btn btn--yellow" target="_blank" rel="noopener">Join as a provider</a>
        </article>
      </div>
    </section>

    <!-- ============================== QUESTIONS ============================== -->
    <section class="section wrap-wide faq" id="questions">
      <div class="faq-intro">
        <span class="mono mono--green">03 / Good to know</span>
        <h2>Questions</h2>
        <p>The short answers. For anything else, ask in the chat.</p>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <span class="faq-plus" aria-hidden="true"></span>
            </summary>
            <p>
              {f.a}
              {f.q === 'What happens to my details?' && <> <a href="/privacy">Privacy policy</a></>}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- ============================== SAY HELLO ============================== -->
    <section class="wrap-wide">
      <div class="hello">
        <div>
          <span class="mono mono--yellow">Your next job starts here</span>
          <h2>Say hello.</h2>
        </div>
        <div class="hello-side">
          <p>Tell Hustlr what you need, or what you do. It takes one message.</p>
          <a href={WA} class="btn btn--yellow" target="_blank" rel="noopener">Chat on WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer wrap-wide">
    <div class="footer-left">
      <a href="#top" class="logo logo--dark" aria-label="Hustlr home">Hustlr.</a>
      <span>Built by Zimnovate</span>
    </div>
    <div class="footer-right">
      <a href="/privacy">Privacy policy</a>
      <a href={WA} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </footer>
</HomeLayout>
