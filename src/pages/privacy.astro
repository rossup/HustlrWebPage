---
import HomeLayout from '../layouts/HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { WA } from '../data/site';
import '../styles/redesign.css';

const sections = [
  { id: 'information', title: 'Information we receive' },
  { id: 'use', title: 'How we use information' },
];
---

<HomeLayout
  title="Privacy Policy — Hustlr"
  description="How Hustlr handles information when you visit our website or contact us."
>
  <SiteNav />

  <header class="rd-page-head" id="top">
    <div class="rd-wrap">
      <p class="rd-eyebrow">Legal</p>
      <h1>Privacy policy</h1>
      <p class="rd-updated">Last updated: <time datetime="2026-10-26">26 October 2026</time></p>
    </div>
  </header>

  <main class="rd-wrap">
    <div class="rd-legal">
      <nav class="rd-toc" aria-label="On this page">
        <span class="rd-label">On this page</span>
        {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        <a href={WA} class="rd-btn rd-btn--dark" target="_blank" rel="noopener">Questions? Ask on WhatsApp</a>
      </nav>
    <article class="rd-legal-body">
      <p class="rd-legal-intro">
        This policy explains how hustlr.chat handles personal information through this website and enquiries you send to us. It covers the website and initial contact; individual services, pilots, or payment providers may have additional privacy notices presented when you use them.
      </p>

      <section aria-labelledby="information">
        <h2 id="information">Information we receive</h2>
        <ul>
          <li><strong>Contact enquiries:</strong> your name, email address, message, and any other information you choose to include in the contact form.</li>
          <li><strong>WhatsApp enquiries:</strong> if you message us, we receive the phone number, profile information, messages, and attachments that WhatsApp makes available to the recipient.</li>
          <li><strong>Technical information:</strong> hosting and service providers may process your IP address, browser details, requested pages, and request times to deliver and protect the website.</li>
          <li><strong>Website analytics:</strong> to understand how the website is used, we record anonymous visits: a random identifier stored in your browser, the pages you view, how you arrived (for example a link or campaign), your device type, and which WhatsApp buttons you tap. This does not include your name, phone number, or IP address, and is not used to identify you. If your browser sends a Do Not Track or Global Privacy Control signal, we do not record these visits.</li>
        </ul>
      </section>

      <section aria-labelledby="use">
        <h2 id="use">How we use information</h2>
        <p>
          We use enquiry information to respond to you, arrange requested demonstrations, discuss services or partnerships, and follow up on your request. Technical information supports website delivery, troubleshooting, and protection against abuse. Analytics information helps us see which parts of the website are useful and improve it.
        </p>
      </section>
    </article>
    </div>
  </main>

  <SiteFooter />
</HomeLayout>
