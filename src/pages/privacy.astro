---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Privacy Policy — hustlr.chat"
  description="How hustlr.chat handles information when you visit our website or contact us."
  bodyClass="privacy-page"
>
  <header class="nav-wrap">
    <nav class="nav container" aria-label="Main navigation">
      <a href="/" class="brand-logo" aria-label="hustlr.chat home">
        <img src="/assets/logo-reverse.svg" alt="hustlr" class="brand-logo-img" />
      </a>
      <a href="/#contact" class="btn-glass-pill">Contact us</a>
    </nav>
  </header>

  <main>
    <article class="container policy">
      <a href="/" class="eyebrow-light">&larr; Back to home</a>
      <h1>Privacy Policy</h1>
      <p>Last updated: <time datetime="2026-10-26">26 October 2026</time></p>
      <p>
        This policy explains how hustlr.chat handles personal information through this website and enquiries you send to us. It covers the website and initial contact; individual services, pilots, or payment providers may have additional privacy notices presented when you use them.
      </p>

      <section aria-labelledby="information">
        <h2 id="information">Information we receive</h2>
        <ul>
          <li><strong>Contact enquiries:</strong> your name, email address, message, and any other information you choose to include in the contact form.</li>
          <li><strong>WhatsApp enquiries:</strong> if you message us, we receive the phone number, profile information, messages, and attachments that WhatsApp makes available to the recipient.</li>
          <li><strong>Technical information:</strong> hosting and service providers may process your IP address, browser details, requested pages, and request times to deliver and protect the website.</li>
        </ul>
      </section>

      <section aria-labelledby="use">
        <h2 id="use">How we use information</h2>
        <p>
          We use enquiry information to respond to you, arrange requested demonstrations, discuss services or partnerships, and follow up on your request. Technical information supports website delivery, troubleshooting, and protection against abuse.
        </p>
      </section>
    </article>
  </main>

  <footer class="footer">
    <div class="container foot">
      <a class="brand-logo" href="/">
        <img src="/assets/logo-primary.svg" alt="hustlr" class="brand-logo-img" />
      </a>
      <div class="foot-links">
        <a href="/#product">Product</a>
        <a href="/#contact">Contact</a>
        <a href="/privacy" aria-current="page">Privacy Policy</a>
      </div>
      <div>&copy; 2026 hustlr.chat</div>
    </div>
  </footer>
</Layout>
