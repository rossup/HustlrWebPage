---
// /hire/{trade}-{city}: one static page per launch trade and city (data in src/data/tradeCityData.ts).
import HomeLayout from '../../layouts/HomeLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { WA, waIcon } from '../../data/site';
import { SITE_URL, PHONE } from '../../data/seo';
import { ACTIVE_TRADES, ACTIVE_CITIES, buildTradeCitySchema, buildTradeCityFaqs, hirePath, hireCanonicalPath, type TradeInfo, type CityInfo } from '../../data/tradeCityData';
import WaChat from '../../components/seo/WaChat.astro';
import { steps } from '../../data/site';
import '../../styles/redesign.css';
import '../../styles/landing.css';

export function getStaticPaths() {
  // Only trades marked isActive get pages
  return ACTIVE_TRADES.flatMap((trade) =>
    ACTIVE_CITIES.map((city) => ({ params: { slug: `${trade.slug}-${city.slug}` }, props: { trade, city } })),
  );
}

interface Props {
  trade: TradeInfo;
  city: CityInfo;
}

const { trade, city } = Astro.props;
const path = hirePath(trade, city);
const pageUrl = `${SITE_URL}${path}`;
const faqs = buildTradeCityFaqs(trade, city);
const schema = buildTradeCitySchema(trade, city, pageUrl, faqs);
const lower = trade.singular.toLowerCase();
const article = /^[aeiou]/i.test(lower) ? 'an' : 'a';
const waHref = `${WA}?text=${encodeURIComponent(`Hi Hustlr, I need ${article} ${lower} in ${city.name}.`)}`;
const example = trade.example.replace('{area}', city.suburbs[0]);
const rate = trade.typicalRateUsd;

const sameTradeElsewhere = ACTIVE_CITIES.filter((c) => c.slug !== city.slug).map((c) => ({ label: `${trade.plural} in ${c.name}`, href: hirePath(trade, c) }));
const otherTradesHere = ACTIVE_TRADES.filter((t) => t.slug !== trade.slug).map((t) => ({ label: `${t.plural} in ${city.name}`, href: hirePath(t, city) }));
const suburbList = `${city.suburbs.slice(0, -1).join(', ')} and ${city.suburbs[city.suburbs.length - 1]}`;
---

<HomeLayout
  title={`${trade.plural} in ${city.name} | Hire on WhatsApp – Hustlr`}
  description={`Hire vetted ${trade.plural.toLowerCase()} in ${city.name}, including ${city.suburbs.slice(0, 3).join(', ')}, directly on WhatsApp. Chat in English, ChiShona or IsiNdebele. No app needed, free to ask.`}
  schema={schema}
  canonicalPath={hireCanonicalPath(trade, city)}
  ogImageAlt={`Hire Vetted ${trade.plural} in ${city.name} on WhatsApp — Hustlr`}
>
  <SiteNav />

  <header class="rd-page-head lp-head" id="top">
    <div class="rd-wrap lp-head-inner">
      <div class="lp-head-copy">
        <nav class="lp-crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Hustlr Zimbabwe</a></li>
            <li><span aria-current="page">{trade.plural} in {city.name}</span></li>
          </ol>
        </nav>
        <p class="rd-eyebrow">{trade.plural} · {city.name}</p>
        <h1>Hire Vetted {trade.plural} in {city.name} Directly on WhatsApp.</h1>
        <p class="lp-lead">
          Find {trade.plural.toLowerCase()} who work in {suburbList}. No app download required: describe the job in English,
          ChiShona or IsiNdebele and Hustlr matches you with someone nearby.
        </p>
        <div class="lp-actions">
          <a href={waHref} class="rd-btn rd-btn--yellow" target="_blank" rel="noopener" data-placement="page"><Fragment set:html={waIcon} />Chat on WhatsApp</a>
          <span>or save <strong>{PHONE}</strong></span>
        </div>
      </div>

      <WaChat
        caption="Ask in your language"
        messages={[
          { from: 'out', text: example },
          city.primaryVernacular === 'sn' ? { from: 'out', text: trade.shona, lang: 'sn' } : { from: 'out', text: trade.ndebele, lang: 'nd' },
          { from: 'in', text: `Got it. Here are ${trade.plural.toLowerCase()} who cover your area.` },
        ]}
      />
    </div>
  </header>

  <main class="rd-wrap lp-main">
    <section class="lp-split" aria-label={`${trade.plural} in ${city.name}`}>
      <div class="lp-card">
        <h2>What you can hire {article} {lower} for</h2>
        <ul class="lp-jobs">
          {trade.commonTasks.map((t) => <li>{t}</li>)}
        </ul>
        <p class="lp-small">Something else? Describe any job in the chat.</p>
      </div>
      <div class="lp-card">
        <h2>{trade.plural} across {city.name}</h2>
        <p class="lp-small lp-context">{city.localContext}</p>
        <ul class="lp-areas">
          {city.suburbs.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <p class="lp-note">
      <span class="lp-note-label">Price</span>
      {rate ? (
        <span>Typically <strong>{rate}</strong>. You agree the final price with the provider before work starts.</span>
      ) : (
        <span>Asking Hustlr is free. You agree the price for the job with the provider before any work starts.</span>
      )}
    </p>

    <section class="rd-section" aria-labelledby="lp-how">
      <span class="rd-pill">How it works</span>
      <h2 class="rd-h2 lp-h2" id="lp-how">Booked in three messages</h2>
      <ol class="lp-steps">
        {steps.map((st) => (
          <li>
            <span class="lp-step-n">{st.n.padStart(2, '0')}</span>
            <h3>{st.title}</h3>
            <p>{st.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="rd-section rd-faq" id="questions" aria-labelledby="local-faq-heading">
      <div class="rd-faq-intro">
        <span class="rd-pill">FAQ</span>
        <h2 class="rd-h2 lp-h2" id="local-faq-heading">{trade.plural} in {city.name}: questions</h2>
        <p class="rd-lead">Ask in English, ChiShona or IsiNdebele. Hustlr understands all three.</p>
      </div>
      <div class="rd-faq-list">
        {faqs.map((f, i) => (
          <details lang={f.lang === 'en' ? 'en-ZW' : f.lang} open={i === 0}>
            <summary>{f.question}<span class="rd-faq-plus" aria-hidden="true"></span></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="rd-section lp-more lp-more--split" aria-label="More trades and cities">
      <div>
        <h2>Other trades in {city.name}</h2>
        <ul>
          {otherTradesHere.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{trade.plural} in other cities</h2>
        <ul>
          {sameTradeElsewhere.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="/hire">All trades and cities</a></li>
        </ul>
      </div>
    </nav>

    <section class="rd-section">
      <div class="rd-cta">
        <h2>Need {article} {lower} in {city.name}?</h2>
        <div class="rd-cta-side">
          <a href={waHref} class="rd-btn rd-btn--dark" target="_blank" rel="noopener" data-placement="page"><Fragment set:html={waIcon} />Chat on WhatsApp</a>
          <span>or save {PHONE}</span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</HomeLayout>
