---
// /login: admin sign-in with Supabase Auth, through this site's own /api/auth/* endpoints
// (src/pages/api/auth/[action].ts), so the browser never holds the session tokens.
// Also finishes the links Supabase emails: accepting an invite and resetting a password.
import HomeLayout from '../layouts/HomeLayout.astro';
import '../styles/redesign.css';
import '../styles/admin.css';
---

<HomeLayout title="Admin login — Hustlr" description="Hustlr admin login." noindex scale={false}>
  <main class="ad-login">
    <div class="ad-login-card">
      <a href="/" class="ad-login-logo" aria-label="Hustlr home">
        <img src="/assets/logo-primary.svg" alt="Hustlr" width="106" height="38" />
        <span class="ad-side-tag">Admin</span>
      </a>

      <!-- Sign in -->
      <form class="ad-login-form" id="loginForm" hidden>
        <h1>Sign in</h1>
        <p class="ad-login-lead">Use the email you were invited with.</p>
        <label>Email <input type="email" name="email" autocomplete="username" required /></label>
        <label>Password <input type="password" name="password" autocomplete="current-password" required /></label>
        <button type="submit" class="rd-btn rd-btn--yellow">Sign in</button>
        <button type="button" class="ad-login-link" id="forgotBtn">Forgot your password?</button>
      </form>

      <!-- Set a password: accepting an invite, or after a reset link -->
      <form class="ad-login-form" id="passwordForm" hidden>
        <h1 id="passwordTitle">Choose a password</h1>
        <p class="ad-login-lead" id="passwordLead">Set the password you'll use to sign in.</p>
        <label>New password <input type="password" name="password" autocomplete="new-password" minlength="8" required /></label>
        <button type="submit" class="rd-btn rd-btn--yellow">Save password</button>
      </form>

      <!-- Signed in but not an admin -->
      <div class="ad-login-form" id="noAccess" hidden>
        <h1>No admin access</h1>
        <p class="ad-login-lead">
          You're signed in as <strong id="noAccessEmail"></strong>, but this account isn't on the admin list.
          Ask an owner to add your email, then sign in again.
        </p>
        <button type="button" class="rd-btn rd-btn--yellow" id="switchBtn">Sign in with another account</button>
      </div>

      <p class="ad-login-msg" id="loginMsg" role="status" aria-live="polite"></p>
    </div>
  </main>

  <script>
    type Who = { email: string | null; admin: boolean };

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const loginForm = $<HTMLFormElement>('loginForm');
    const passwordForm = $<HTMLFormElement>('passwordForm');
    const noAccess = $<HTMLDivElement>('noAccess');
    const msg = $<HTMLParagraphElement>('loginMsg');

    // Only send people back to admin pages after signing in
    const requested = new URLSearchParams(location.search).get('next') ?? '';
    const nextPath = /^\/admin(\/[\w-]*)*\/?$/.test(requested) ? requested : '/admin';

    const say = (text: string, isError = false) => {
      msg.textContent = text;
      msg.classList.toggle('is-error', isError);
    };
    const show = (el: HTMLElement) => {
      [loginForm, passwordForm, noAccess].forEach((x) => (x.hidden = x !== el));
      el.querySelector<HTMLInputElement>('input')?.focus();
    };
    const errorText = (error: unknown) =>
      error instanceof Error && error.message ? error.message : 'Something went wrong. Try again.';

    /** Calls one of this site's /api/auth endpoints. Throws the endpoint's message on failure. */
    async function api<T>(action: string, body?: Record<string, string>): Promise<T> {
      const response = await fetch(`/api/auth/${action}`, {
        method: body ? 'POST' : 'GET',
        headers: body ? { 'Content-Type': 'application/json' } : undefined,
        body: body ? JSON.stringify(body) : undefined,
        credentials: 'same-origin',
      });
      const data = await response.json().catch(() => null);
      if (!response.ok) throw new Error(data?.error ?? 'Something went wrong. Try again.');
      return data as T;
    }

    const goIn = (who: Who) => {
      if (who.admin) {
        location.replace(nextPath);
        return;
      }
      $<HTMLElement>('noAccessEmail').textContent = who.email ?? 'this account';
      show(noAccess);
    };

    // The tokens an invite or reset link put in the address, used once to set the password
    let linkTokens: { accessToken: string; refreshToken: string } | null = null;

    async function start() {
      // Supabase's email links land here with their result after the #
      const hash = new URLSearchParams(location.hash.slice(1));
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);

      const linkError = hash.get('error_description');
      if (linkError) say(`${linkError}. Ask for a new link.`, true);

      const accessToken = hash.get('access_token');
      const refreshToken = hash.get('refresh_token');
      if (accessToken && refreshToken) {
        linkTokens = { accessToken, refreshToken };
        $<HTMLElement>('passwordTitle').textContent =
          hash.get('type') === 'invite' ? 'Welcome to Hustlr admin' : 'Choose a new password';
        show(passwordForm);
        return;
      }

      try {
        const who = await api<Who>('me');
        if (who.email) return goIn(who);
      } catch {
        /* not signed in, or sign-in not reachable: show the form */
      }
      show(loginForm);
    }

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(loginForm);
      say('Signing in…');
      try {
        const who = await api<Who>('login', {
          email: String(data.get('email')),
          password: String(data.get('password')),
        });
        say('');
        goIn(who);
      } catch (error) {
        say(errorText(error), true);
      }
    });

    passwordForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = String(new FormData(passwordForm).get('password'));
      if (!linkTokens) {
        say('This link has expired. Ask for a new one.', true);
        show(loginForm);
        return;
      }
      say('Saving…');
      try {
        const who = await api<Who>('password', { ...linkTokens, password });
        linkTokens = null;
        say('');
        goIn(who);
      } catch (error) {
        say(errorText(error), true);
      }
    });

    $<HTMLButtonElement>('forgotBtn').addEventListener('click', async () => {
      const email = String(new FormData(loginForm).get('email') ?? '').trim();
      if (!email) {
        say('Type your email above first.', true);
        return;
      }
      try {
        await api('recover', { email });
        say('If that email has an account, a reset link is on its way.');
      } catch (error) {
        say(errorText(error), true);
      }
    });

    $<HTMLButtonElement>('switchBtn').addEventListener('click', async () => {
      try {
        await api('logout', {});
      } catch {
        /* already signed out */
      }
      say('');
      show(loginForm);
    });

    start();
  </script>
</HomeLayout>
