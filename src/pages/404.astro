---
import HomeLayout from '../layouts/HomeLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { WA, waIcon } from '../data/site';
import '../styles/redesign.css';


const quick = [
  { label: 'Plumber', text: 'I need a plumber' },
  { label: 'Electrician', text: 'I need an electrician' },
  { label: 'Cleaner', text: 'I need a cleaner' },
  { label: 'Tutor', text: 'I need a tutor' },
];
---

<HomeLayout title="Page not found — Hustlr" description="This page doesn't exist. Head back home, or tell Hustlr on WhatsApp what you need.">
  <SiteNav />

  <main class="rd-nf" id="top">
    <div class="rd-wrap rd-nf-inner">
      <div class="rd-nf-copy">
        <p class="rd-eyebrow">Error 404 · Page not found</p>

        <!-- The "0" is a chat bubble that's still typing -->
        <p class="rd-nf-code" aria-hidden="true">
          <span>4</span>
          <svg viewBox="0 0 120 150" fill="none">
            <path d="M60 8c28.7 0 52 19.6 52 50v28c0 30.4-23.3 50-52 50-8.4 0-16.3-1.7-23.3-4.8L14 141l7.4-21.3C12.7 110.6 8 99.4 8 86V58C8 27.6 31.3 8 60 8z" fill="var(--yellow)" />
            <circle class="rd-nf-dot" cx="38" cy="72" r="7.5" fill="var(--ink)" />
            <circle class="rd-nf-dot" cx="60" cy="72" r="7.5" fill="var(--ink)" />
            <circle class="rd-nf-dot" cx="82" cy="72" r="7.5" fill="var(--ink)" />
          </svg>
          <span>4</span>
        </p>

        <h1>This page took a wrong turn.</h1>
        <p class="rd-nf-lead">The link may be old, or the page has moved. Help is still one message away.</p>

        <div class="rd-nf-actions">
          <a href={WA} class="rd-btn rd-btn--yellow" target="_blank" rel="noopener"><Fragment set:html={waIcon} />Chat on WhatsApp</a>
          <a href="/" class="rd-link">Go to the homepage <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <div class="rd-nf-chat-wrap">
        <div class="rd-nf-chat">
          <div class="rd-nf-chat-head">
            <span class="rd-nf-avatar" aria-hidden="true">H</span>
            <span><strong>Hustlr</strong><small>online</small></span>
          </div>
          <div class="rd-nf-chat-body">
            <div class="rd-bubble rd-bubble--me">I was looking for <span class="rd-nf-path" id="nfPath">a page</span></div>
            <div class="rd-bubble rd-bubble--bot">That page isn't here anymore. But I can still find you someone. What do you need?</div>
            <div class="rd-nf-chips">
              {quick.map((q) => (
                <a href={`${WA}?text=${encodeURIComponent(q.text)}`} target="_blank" rel="noopener">{q.label}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />

  <script>
    // Show the path the visitor tried, e.g. "/plumbers-harare"
    const el = document.getElementById('nfPath');
    const path = decodeURIComponent(window.location.pathname);
    if (el && path && path !== '/') el.textContent = path.length > 32 ? `${path.slice(0, 31)}…` : path;
  </script>
</HomeLayout>
